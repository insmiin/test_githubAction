            <stringProp name="script">
// =========logic check
import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def responseCode = prev.getResponseCode()
def expectedResult = &apos;OK&apos;
def actualResult = json.status

def status = (actualResult == expectedResult) ? &apos;Passed&apos; : &apos;Failed&apos;
def failedReason = &apos;&apos;

if (status == &apos;Failed&apos;) {
    failedReason = &apos;expecting status to be OK&apos;
}
// ========get ready and Append to CSV===================
import org.apache.jmeter.services.FileServer

def baseDir = FileServer.getFileServer().getBaseDir()
def csvFile = new File(baseDir, &apos;${fileName}&apos;)

// Get information from the current sampler
def label = prev.getSampleLabel()
def url = prev.getURL().toString()
synchronized (this.class) {
    csvFile &lt;&lt; &quot;\&quot;${label}\&quot;,\&quot;${url}\&quot;,\&quot;${responseCode}\&quot;,\&quot;${actualResult}\&quot;,\&quot;${expectedResult}\&quot;,\&quot;${status}\&quot;,\&quot;${failedReason}\&quot;\n&quot;
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Request books fiction type" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="type" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">non-fiction</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">type</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain"></stringProp>
          <stringProp name="HTTPSampler.port"></stringProp>
          <stringProp name="HTTPSampler.protocol"></stringProp>
          <stringProp name="HTTPSampler.contentEncoding"></stringProp>
          <stringProp name="HTTPSampler.path">/books</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout"></stringProp>
          <stringProp name="HTTPSampler.response_timeout"></stringProp>
          <stringProp name="TestPlan.comments">purposely request non-fiction, so that my assertion will fail. as i assert it to be fiction</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor" enabled="false">
            <stringProp name="JSONPostProcessor.referenceNames">bookTypes</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$..type</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">-1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">not found</stringProp>
            <boolProp name="JSONPostProcessor.compute_concat">true</boolProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="false">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">int count = vars.get(&apos;bookTypes_matchNr&apos;) as int

for (int i = 1; i &lt;= count; i++) {
    if (vars.get(&quot;bookTypes_${i}&quot;) != &apos;fiction&apos;) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(
            &quot;Book at index ${i} is not fiction&quot;
        )
        break
    }
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// ========logic check===================
import groovy.json.JsonSlurper

def actualResult
def expectedResult
def status

// Get response code
def responseCode = prev.getResponseCode()

// Get response body
def responseBody = prev.getResponseDataAsString()

// Parse JSON
def books = new JsonSlurper().parseText(responseBody)
def failedReason = &apos;&apos;
// 1. Check response code
if (responseCode != &apos;200&apos;) {

    actualResult = responseCode
    expectedResult = &apos;200&apos;
    status = &apos;Failed&apos;
    failedReason = &quot;expecting http response code to be ${expectedResult}&quot;
}
// 2. Check that JSON is not empty
else if (books == null || books.isEmpty()) {

    actualResult = &apos;empty&apos;
    expectedResult = &apos;not empty&apos;
    status = &apos;Failed&apos;
    failedReason = &quot;expecting Json to return data&quot;

}
// 3. Check book type
else if (books.any { it.type != &apos;non-fiction&apos; }) {

    actualResult = &apos;non-fiction&apos;
    expectedResult = &apos;fiction&apos;
    status = &apos;Failed&apos;
    failedReason = &quot;expecting API to return only fiction&quot;

}
// 4. Everything passed
else {

    actualResult = &apos;non-fiction&apos;
    expectedResult = &apos;non-fiction&apos;
    status = &apos;Passed&apos;
}

log.info(&quot;Actual Result: ${actualResult}&quot;)
log.info(&quot;Expected Result: ${expectedResult}&quot;)
log.info(&quot;Status: ${status}&quot;)
